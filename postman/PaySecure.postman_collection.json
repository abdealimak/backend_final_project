      "item": [
        {
          "name": "Register (Customer)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"test@example.com\",\n  \"password\": \"test123\",\n  \"role\": \"customer\"\n}"
            }
          }
        },
        {
          "name": "Register (Merchant)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Merchant\",\n  \"email\": \"testmerchant@example.com\",\n  \"password\": \"test123\",\n  \"role\": \"merchant\"\n}"
            }
          }
        },
        {
          "name": "Login (Customer)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@paysecure.com\",\n  \"password\": \"customer123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"jwt\", jsonData.data.token);",
                  "    console.log(\"Saved JWT to collection variable:\", jsonData.data.token.substring(0, 15) + \"...\");",
                  "}",
                  "if (jsonData.data && jsonData.data.user && jsonData.data.user.role === \"merchant\" && jsonData.data.user.merchantId) {",
                  "    pm.collectionVariables.set(\"merchantId\", jsonData.data.user.merchantId);",
                  "}"
                ]
              }
            }
          ]
        },
