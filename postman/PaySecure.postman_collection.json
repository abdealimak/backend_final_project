{
  "info": {
    "name": "PaySecure API Collection",
    "description": "Complete API collection for the PaySecure Payment Gateway System.\n\nSetup:\n1. Run the seed script: npm run seed\n2. Login with demo credentials to get a JWT token\n3. Set the 'jwt' variable with the token\n\nDemo Credentials:\n- Admin: admin@paysecure.com / admin123\n- Customer: customer@paysecure.com / customer123\n- Merchant: merchant@paysecure.com / merchant123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "merchantId",
      "value": ""
    },
    {
      "key": "paymentMethodId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "refundId",
      "value": ""
    },
    {
      "key": "settlementId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
